# Graphix package release (https://github.com/graphix-asterixdb/package/releases)
GRAPHIX_VERSION=0.4.1
# Java of the container (the AsterixDB of STGraph runs on Java 21; Graphix documents Java 11)
JAVA_VERSION=21

# Host ports (container: 19001 cluster controller, 19002 query API, 19006 web UI).
# The query API for loaders and tests is always published on 29002.
GRAPHIX_CC_PORT=29001
GRAPHIX_UI_PORT=29006
# The web UI calls the query API on localhost:19002 (hard-coded in the UI). If the AsterixDB of STGraph is
# running at the same time, set another free port here: the web UI stops working, the loaders do not.
GRAPHIX_UI_API_PORT=29002

# Data of Graphix (storage and transaction log): a host directory instead of the Docker volume graphix-data
# GRAPHIX_DATA=/path/to/graphix-data
