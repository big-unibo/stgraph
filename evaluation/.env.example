# ===================================================
# SmartBench Experiment Configuration
# ===================================================
# Configuration of the systems evaluated inside their own container (run_tests.sh): AeonG and HyGraph.
# Multiple values are comma-separated.
# STGraph, Neo4j, PGAge and Graphix run from the Kotlin mains, configured by src/main/resources/test_config.yml.
# ===================================================

# ------------------------
# Test setup
# ------------------------
EVALUATION_SYSTEMS=aeong,hygraph
DATASET=smartbench
DATASET_SIZE=big
INGESTION_ITERATIONS=1
QUERY_ITERATIONS=10
THREAD=1
QUERY_SELECTIVITY=increased
QUERIES=EnvironmentCoverage,EnvironmentAggregate,MaintenanceOwners,EnvironmentOutlier,AgentOutlier,AgentHistory
